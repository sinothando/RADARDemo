{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RADAR: run web app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "RADAR: build fictional demo data",
      "type": "debugpy",
      "request": "launch",
      "module": "radar.seed",
      "args": ["--force"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "RADAR: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-t", ".", "-s", "tests", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
